# Zenox application server.
#
#   sudo cp /opt/zenox/deploy/zenox.service /etc/systemd/system/zenox.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zenox
#
# Next.js loads /opt/zenox/.env itself from the working directory, so there is
# no EnvironmentFile here. That matters: systemd's EnvironmentFile parser would
# mangle the JSON in STREAM_PROVIDERS, while Next's dotenv loader handles it.

[Unit]
Description=Zenox streaming platform (Next.js)
Documentation=https://github.com/pseudointellectualism/zenox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zenox
Group=zenox
WorkingDirectory=/opt/zenox

Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

# Bind to loopback only. Caddy is the sole public entry point, so the app is
# unreachable from the internet except through it.
ExecStart=/usr/bin/node /opt/zenox/node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zenox

# --- hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# ProtectSystem=strict makes the whole filesystem read-only, so name the few
# paths the app legitimately writes: the build output and the gate key store.
ReadWritePaths=/opt/zenox/.next /opt/zenox/data

[Install]
WantedBy=multi-user.target
