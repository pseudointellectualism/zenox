# ============================================================================
# Zenox configuration. Copy to .env.local (dev) or .env (server) and fill in.
# Nothing here is read at runtime by the browser except NEXT_PUBLIC_* values,
# which Next.js INLINES AT BUILD TIME — they must be set before `next build`,
# not just before `next start`.
# ============================================================================

# ---------------------------------------------------------------- identity
# Canonical origin, no trailing slash. Everything that used to hardcode a
# domain now derives from this: page metadata, OAuth redirect URIs, the
# playback referer allowlist, and the admin cookie scope.
NEXT_PUBLIC_SITE_URL=https://example.com

# Registrable apex domain. Subdomains of it are trusted for playback and share
# the admin session cookie. Leave blank to derive it from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_DOMAIN=example.com

# Brand name used in titles, Open Graph tags, and the admin panel.
NEXT_PUBLIC_SITE_NAME=Zenox

# Community link. The Discord control stays hidden until this is set.
NEXT_PUBLIC_DISCORD_URL=

# Contact address Let's Encrypt uses for certificate expiry warnings.
ACME_EMAIL=

# -------------------------------------------------------------- catalog API
# Optional. Without it the app serves the fallback catalog in lib/mock-data.ts.
# v3 auth: an API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ---------------------------------------------------------------- playback
# JSON array of your own playback endpoints. Zenox ships with none, so until
# this is set the player shows its configuration empty state.
# Tokens: {id} {season} {episode} {title} {year}
# kind: "hls" for a direct .m3u8, "embed" for a sandboxed iframe.
# Embed origins listed here are added to the CSP frame-src allowlist automatically.
# STREAM_PROVIDERS=[{"id":"studio","label":"Studio CDN","kind":"hls","movie":"https://cdn.example.com/m/{id}/master.m3u8","tv":"https://cdn.example.com/t/{id}/{season}/{episode}/master.m3u8"}]
STREAM_PROVIDERS=

# Secret that signs the short-lived AES-256-GCM playback tokens. Generate with:
#   openssl rand -hex 32
# If unset, a random key is minted per process and tokens break across restarts
# and across multiple app instances behind a load balancer.
STREAM_TOKEN_SECRET=

# Your own stream resolver service. The /api/v1/stream/[token] route forwards
# verified token payloads to `${SCRAPER_VPS_URL}/stream` with the shared secret
# below in an X-Zenox-Secret header, and returns the HLS manifest it responds with.
SCRAPER_VPS_URL=
SCRAPER_API_SECRET=

# Extra hostnames allowed to request playback, comma separated. The site domain
# and its subdomains are always trusted; use this for a staging host.
STREAM_ALLOWED_HOSTS=

# Extra origins added to the CSP media-src and connect-src allowlists, comma
# separated. Needed when your stream segments are served from another host.
# e.g. https://bub.example.com
STREAM_EXTRA_ORIGINS=

# --------------------------------------------------------------- accounts
# Accounts, sync and notifications. Create a project at https://supabase.com,
# then run supabase/schema.sql in its SQL editor. The first two are safe to
# ship: the anon key is public by design and constrained by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row level security — never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------- owner admin panel
# Owner logins. There are NO built-in credentials: with nothing set here every
# login attempt fails. Supports ADMIN_USER_1..8 with matching ADMIN_PASS_n.
#
# Each password is stored as an scrypt digest, never in clear text. Generate
# one with a hidden prompt so it never reaches your shell history:
#
#   node scripts/hash-password.mjs
#
# Paste the printed `scrypt$...` string as the ADMIN_PASS value. A clear-text
# value still works for migration but logs a warning on every login.
ADMIN_USER_1=
ADMIN_PASS_1=
ADMIN_USER_2=
ADMIN_PASS_2=

# Signs admin session cookies. Generate with:
#   openssl rand -hex 32
# Unset means an ephemeral key: sessions drop on every restart.
ADMIN_SESSION_SECRET=

# Exact hostname serving the admin panel. The panel is reachable ONLY here and
# returns 404 for /admin on every other host, so this is not a guess: set it.
# Matched in full, not by prefix. Defaults to admin.<site domain>.
ADMIN_DOMAIN=admin.example.com

# ------------------------------------------------------ tracker integrations
# Register your OWN application with each provider. Set the redirect URI to
# exactly NEXT_PUBLIC_SITE_URL above, or the token exchange is rejected.
# Client IDs appear in the browser's authorize URL, so each is duplicated as a
# NEXT_PUBLIC_ value. Secrets must never get a NEXT_PUBLIC_ prefix.
# A provider with no client ID simply stays disconnected in the UI.

# https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
NEXT_PUBLIC_TRAKT_CLIENT_ID=

# https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
NEXT_PUBLIC_SIMKL_CLIENT_ID=

# https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
NEXT_PUBLIC_MAL_CLIENT_ID=

# https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
NEXT_PUBLIC_ANILIST_CLIENT_ID=

# ---------------------------------------------------------------- subtitles
# Optional API key for the Wyzie subtitle search backend.
WYZIE_API_KEY=
